# 複製成 .env 後填入（.env 不會被提交到 git）
# 支援任何 OpenAI 相容的服務商：只需改以下三行

AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# ---------- 常見服務商設定（取消註解其中一組）----------
# 模型名稱只是例子，請以各服務商控制台的最新清單為準

# OpenAI（AI_BASE_URL 留空即可，AI_MODEL 預設 gpt-5.5）
# AI_BASE_URL=
# AI_MODEL=gpt-5.5

# DeepSeek（deepseek-chat 已於 2026-07-24 停用，改用 deepseek-flash）
# 關閉思考模式：客服回覆更快、更便宜
# AI_BASE_URL=https://api.deepseek.com
# AI_MODEL=deepseek-flash
# AI_EXTRA_PARAMS={"thinking":{"type":"disabled"},"max_tokens":800}

# 阿里雲 通義千問（DashScope）
# AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AI_MODEL=qwen-plus

# 月之暗面 Kimi（Moonshot）
# AI_BASE_URL=https://api.moonshot.cn/v1
# AI_MODEL=<控制台上的模型名稱>

# 智譜 GLM
# AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# AI_MODEL=<控制台上的模型名稱>

# Google Gemini
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# AI_MODEL=<控制台上的模型名稱>

# 可選：更換端口
# PORT=3000

# ---------- 老闆後台 /admin/ ----------
# 初次啟動可指定至少 12 字元的密碼。留空會生成隨機密碼，保存在 data/admin-access.txt。
# 登入帳號為 owner。建立後登入密碼由 data/owner.json 的雜湊記錄管理。
# ADMIN_PASSWORD=
# DATA_DIR=./data
# 後台儲存的 AI 設定優先於本檔案設定，改動後對新的客服回覆即時生效。

# ---------- 直播（Facebook 專頁：1314 Luxury ForLady）----------
# 填入後網站會每分鐘自動偵測專頁是否正在直播，並自動更新「最近直播重溫」。
# 需要專頁管理員在 developers.facebook.com 建立應用程式，取得「長期專頁存取權杖」（權限：pages_read_engagement）。
# 不填亦可：開播時在 live.config.json 的 "liveNow" 填入直播影片網址即可（改完即時生效）。
# FB_PAGE_ID=
# FB_PAGE_TOKEN=

# ---------- 巡查員 WhatsApp Business 官方回調（可選） ----------
# 已授權接收私訊時填入三項並重新啟動，PATROL_DEMO=1 會關閉此入口。
# WHATSAPP_PATROL_PHONE_NUMBER_ID=
# WHATSAPP_PATROL_VERIFY_TOKEN=
# WHATSAPP_PATROL_APP_SECRET=
